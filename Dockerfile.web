# syntax=docker/dockerfile:1.7
#
# Dockerfile.web — Next.js 15 production image (plan T70, arch §3.3, §9.2 Faza 6)
#
# Multi-stage: deps → builder → runner. Finalny obraz oparty na alpine,
# non-root (uid 1001), z `output: "standalone"` (next.config.mjs) — ~150-200 MB.
#
# Build:  docker build -f Dockerfile.web -t tibians-web .
# Run:    docker run -p 3000:3000 --env-file .env.production tibians-web

# ─── Stage 1: deps — pełne node_modules dla build ─────────────────────────
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /repo
# Manifesty workspace (cache-friendly: zmieniają się rzadko).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/scraper/package.json ./apps/scraper/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/calc/package.json ./packages/calc/package.json
COPY packages/character-context/package.json ./packages/character-context/package.json
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ─── Stage 2: builder — kompilacja Next.js ────────────────────────────────
FROM deps AS builder
WORKDIR /repo
COPY . .
# Dummy env dla build-time (sekrety wstrzykiwane w runtime, nie w obraz).
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm --filter @tibians/web... build

# ─── Stage 3: runner — minimalny runtime ──────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Non-root user (arch §9.2 — security).
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs nextjs

# `standalone` zawiera server.js + minimalne node_modules.
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

# Healthcheck (T75 użyje /api/health — endpoint dodany w T38/T75).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health >/dev/null 2>&1 || exit 1

CMD ["node", "apps/web/server.js"]
