# PostgreSQL connection string (used by packages/db)
DATABASE_URL=postgresql://tibians:tibians@localhost:5432/tibians

# PostgreSQL credentials (used by docker-compose.yml db service)
POSTGRES_USER=tibians
POSTGRES_PASSWORD=tibians
POSTGRES_DB=tibians

# Hostname of the TibiaData service inside the docker network (used by other
# containers to reach it by name). From the host use http://localhost:8080.
TIBIADATA_HOST=tibiadata

# Host port for the Adminer UI (dev only, bound to 127.0.0.1)
ADMINER_PORT=8081

# Shared secret between scraper and API (used to authenticate scrape webhooks)
SCRAPER_SECRET=change-me

# Base URL of the self-hosted TibiaData API (see docker-compose in task 6)
# Internal (from docker network): http://tibiadata:8080
# From host: http://localhost:8080
TIBIADATA_BASE_URL=http://localhost:8080

# Public site URL (used for canonical links, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
