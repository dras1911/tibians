# .env.production.example — Tibians PRODUCTION (plan T71, arch §3.3)
#
# Użycie:
#   cp .env.production.example .env.production
#   # uzupełnij wszystkie <...> wartości prawdziwymi sekretami
#   docker compose -f docker-compose.prod.yml up -d --build
#
# NIGDY nie commituj .env.production (jest w .gitignore i .dockerignore).

# ─── Domena + SSL (wymagane przez Caddy, T72) ───────────────────────────
DOMAIN=tibians.tools
ACME_EMAIL=admin@tibians.tools

# ─── PostgreSQL (wewnętrzny w sieci tibians-net) ────────────────────────
POSTGRES_USER=tibians
# Wygeneruj: openssl rand -base64 32
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=tibians

# ─── Aplikacja: połączenia do DB ────────────────────────────────────────
# Host = nazwa serwisu compose (`db`), nie `localhost`.
DATABASE_URL=postgresql://tibians:<CHANGE_ME_STRONG_PASSWORD>@db:5432/tibians

# ─── Scraper: sekret webhooka revalidate (T38 ↔ T36) ────────────────────
# Musi być IDENTYCZNY w web i scraper (współdzielone przez .env.production).
# Wygeneruj: openssl rand -hex 32
SCRAPER_SECRET=<CHANGE_ME_SCRAPER_SECRET>
REVALIDATE_SECRET=<CHANGE_ME_REVALIDATE_SECRET>

# ─── Scraper: budżet rate-limit tibia.com (R11) ─────────────────────────
# Współdzielony limit z self-hostowanym TibiaData (ten sam IP VPS).
SCRAPER_MAX_TIBIA_REQS_PER_MIN=120

# ─── TibiaData (self-host; wewnątrz sieci compose) ──────────────────────
TIBIADATA_BASE_URL=http://tibiadata:8080

# ─── Publiczne URL (SEO, canonical, sitemap) ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tibians.tools

# ─── Faza 6+ (Discord OAuth — T78; zostaw puste dopóki nie skonfigurowane) ─
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=<openssl rand -hex 32>

# ─── Faza 7 (Lemon Squeezy / Paddle — T82; puste w MVP) ─────────────────
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
