{
  "name": "@tibians/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./http-client": "./src/http-client.ts",
    "./r11-budget": "./src/r11-budget.ts",
    "./advisory-lock": "./src/advisory-lock.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node --import tsx/esm src/start.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scrap:auctions": "node --import tsx/esm src/cli/scrape.ts full",
    "scrap:items": "node --import tsx/esm src/cli/scrape.ts reference",
    "scrap:scheduler": "node --import tsx/esm src/start.ts",
    "ref:scrape": "node --import tsx/esm src/cli/scrape.ts reference"
  },
  "dependencies": {
    "@tibians/db": "workspace:^",
    "@tibians/shared": "workspace:^",
    "cheerio": "^1.2.0",
    "undici": "^8.10.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "domhandler": "^5.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}