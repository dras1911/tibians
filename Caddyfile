# Caddyfile — Tibians production edge (plan T72 + T77, arch §3.3 §8.5 §18.1)
#
#- Automatyczny SSL (Let's Encrypt) dla {$DOMAIN}
#- Reverse proxy → web:3000
#- SSE pass-through dla /api/auctions/live (KRYTYCZNE: bez tego stream jest buforowany)
#- Cache proxy dla TibiaData (mitygacja R11 — współdzielony budżet rate-limit)
#- Rate limiting: 100 req/min API, 10 req/min revalidate
#- Security headers: HSTS, CSP, X-Frame-Options, itd.
#- Gzip/zstd compression + JSON access log

{
	email {$ACME_EMAIL}
	admin 0.0.0.0:2019

	log {
		format json
		output file /data/logs/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# ─── Security headers (arch §9.2 — A+ na SSL Labs) ────────────────────
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# CSP: self + inline styles (Next.js) + Tibia assets.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://static.tibia.com https://assets.service-exevopan.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# ─── SSE live tracking (T54) — pass-through BEZ buforowania ───────────
	# `flush_interval -1` = natychmiastowy flush każdego eventu.
	# `header_up -X-Accel-Buffering no` = belt-and-braces dla upstream proxy.
	handle /api/auctions/live* {
		reverse_proxy web:3000 {
			flush_interval -1
			header_up -X-Accel-Buffering no
			transport http {
				read_timeout 0        # brak timeoutu dla długożyciowego streamu
				write_timeout 0
			}
		}
	}

	# ─── Revalidate webhook (T38) — niski rate limit, sekret w headerze ───
	handle /api/revalidate* {
		rate_limit {
			zone revalidate
			key {remote_ip}
			events 10
			window 1m
		}
		reverse_proxy web:3000
	}

	# ─── TibiaData proxy z cache (R11 mitygacja — §18.1) ──────────────────
	# Cache'ujemy na edge → mniej uderzeń do tibia.com z naszego IP.
	handle /api/static-data/* {
		uri strip_prefix /api/static-data
		reverse_proxy tibiadata:8080 {
			header_down Cache-Control "public, max-age=3600"
		}
	}

	# ─── Reszta API — rate limit 100/min ──────────────────────────────────
	handle /api/* {
		rate_limit {
			zone api
			key {remote_ip}
			events 100
			window 1m
		}
		reverse_proxy web:3000
	}

	# ─── Wszystko inne → Next.js ──────────────────────────────────────────
	handle {
		reverse_proxy web:3000
	}

	log {
		output file /data/logs/access.log
	}
}
